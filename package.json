{
  "name": "@mahekara28/context-relay",
  "version": "0.4.0-dev.0",
  "description": "Review and carry working context between coding agent sessions.",
  "type": "module",
  "license": "MIT",
  "author": "Mahek Ara",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "keywords": [
    "ai-agents",
    "context",
    "mcp",
    "cli",
    "claude-code",
    "codex",
    "opencode",
    "goose"
  ],
  "bugs": {
    "url": "https://github.com/mahekara28/context-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahekara28/context-relay.git"
  },
  "bin": {
    "relay": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "dist/adapters/*.js",
    "dist/adapters/*.d.ts",
    "dist/adapters/*.js.map",
    "dist/ui",
    "LICENSE",
    "docs/NPM_QUICKSTART.md",
    "docs/HARNESS_CONNECTIONS.md",
    "docs/WORKSPACE.md",
    "docs/releases/NPM_PUBLISHING.md",
    "docs/THREAD_MAP.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/npm/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test packages/relay/test/*.test.mjs",
    "test:package": "node scripts/npm/package-smoke.mjs",
    "prepack": "npm run build",
    "test:browser": "npm run build && playwright test",
    "demo:render": "npm run build && node scripts/npm/render-demo.mjs",
    "site:build": "node scripts/site/build.mjs",
    "site:preview": "node scripts/site/preview.mjs",
    "site:social": "node scripts/site/render-social.mjs",
    "test:site": "npm run site:build && playwright test --config playwright.site.config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "homepage": "https://mahekara28.github.io/context-relay/"
}
